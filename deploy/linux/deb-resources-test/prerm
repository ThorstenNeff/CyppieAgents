#!/bin/sh
# CYP-637 — TEST-SCOPED .deb prerm: stop + disable ONLY the cyppiehub-test.service. Never references the live unit.
set -e

case "$1" in
  remove|upgrade|deconfigure)
    systemctl disable --now cyppiehub-test.service 2>/dev/null || true   # graceful stop (TimeoutStopSec=30) + disable
    ;;
  failed-upgrade)
    ;;
  *)
    echo "prerm called with unknown argument \`$1'" >&2
    exit 1
    ;;
esac

exit 0
