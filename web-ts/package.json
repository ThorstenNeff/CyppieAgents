{
  "name": "cyppie-web-ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "CyppieAgents Web frontend — TypeScript/DOM rewrite (Epic CYP-397). Coexists with the WASM :app:webApp until cutover (W10).",
  "scripts": {
    "dev": "vite",
    "build": "npm run contract:gen && tsc -b && vite build",
    "typecheck": "tsc -b",
    "contract:gen": "node scripts/generate-contract-types.mjs",
    "contract:check": "node scripts/generate-contract-types.mjs && tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.0.0"
  }
}
