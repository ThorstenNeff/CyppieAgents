{
  "name": "cyppie-web-ts",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "CyppieAgents Web frontend — TypeScript/DOM rewrite (Epic CYP-397). Coexists with the WASM :app:webApp until cutover (W10).",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:casing && npm run contract:gen && npm run tokens:gen && tsc -b && vite build",
    "typecheck": "tsc -b",
    "check:casing": "node scripts/check-casing.mjs",
    "contract:gen": "node scripts/generate-contract-types.mjs",
    "tokens:gen": "node scripts/generate-tokens-css.mjs",
    "contract:check": "node scripts/generate-contract-types.mjs && tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "jsdom": "^29.1.1",
    "json-schema-to-typescript": "^15.0.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.0.0"
  }
}
