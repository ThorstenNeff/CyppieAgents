                    "$ref": "#/components/schemas/CommWsClientEvent"
                }
            },
            "EventsWsServerEvent": {
                "payload": {
                    "$ref": "#/components/schemas/EventsWsServerEvent"
                }
            },
            "EventsWsClientEvent": {
                "payload": {
                    "$ref": "#/components/schemas/EventsWsClientEvent"
                }
            },
            "AgentRunStateEvent": {
                "payload": {
                    "$ref": "#/components/schemas/AgentRunStateEvent"
                }
            },
            "AgentTokenUsageEvent": {
                "payload": {
                    "$ref": "#/components/schemas/AgentTokenUsageEvent"
                }
            },
            "AgentBusyStateEvent": {
                "payload": {
