{
    "asyncapi": "2.6.0",
    "info": {
        "title": "Cyppie Agents — WebSocket API",
        "version": "1.0.0",
        "description": "Frontend WS channels. Generated from :core (kotlinx.serialization) — accurate by construction. /ws/hub is the remote-agent wire (connector contract), not a frontend transport."
    },
    "channels": {
        "/ws/comm": {
            "subscribe": {
                "description": "server → client (the client subscribes to receive)",
                "message": {
                    "$ref": "#/components/messages/CommWsServerEvent"
                }
            },
            "publish": {
                "description": "client → server (the client publishes to send)",
                "message": {
                    "$ref": "#/components/messages/CommWsClientEvent"
                }
            }
        },
        "/ws/events": {
            "subscribe": {
                "description": "server → client (the client subscribes to receive)",
                "message": {
                    "$ref": "#/components/messages/EventsWsServerEvent"
                }
            },
            "publish": {
                "description": "client → server (the client publishes to send)",
                "message": {
                    "$ref": "#/components/messages/EventsWsClientEvent"
                }
            }
        },
        "/ws/lifecycle": {
            "subscribe": {
                "description": "server → client (the client subscribes to receive)",
                "message": {
                    "$ref": "#/components/messages/AgentRunStateEvent"
                }
            }
        },
        "/ws/token-usage": {
            "subscribe": {
                "description": "server → client (the client subscribes to receive)",
                "message": {
                    "$ref": "#/components/messages/AgentTokenUsageEvent"
                }
            }
        },
        "/ws/busy-state": {
            "subscribe": {
                "description": "server → client (the client subscribes to receive)",
                "message": {
                    "$ref": "#/components/messages/AgentBusyStateEvent"
                }
            }
        },
        "/ws/terminal-state": {
            "subscribe": {
                "description": "server → client (the client subscribes to receive)",
                "message": {
                    "$ref": "#/components/messages/AgentTerminalControlEvent"
                }
            }
        },
        "/ws/agent": {
            "subscribe": {
                "description": "server → client (the client subscribes to receive)",
                "message": {
                    "$ref": "#/components/messages/StoredAgentEvent"
                }
            },
            "publish": {
                "description": "client → server (the client publishes to send)",
                "message": {
                    "$ref": "#/components/messages/UserTurn"
                }
            }
        },
        "/ws/terminal": {
            "subscribe": {
                "description": "server → client (the client subscribes to receive)",
                "message": {
                    "$ref": "#/components/messages/TerminalServerFrame"
                }
            },
            "publish": {
                "description": "client → server (the client publishes to send)",
                "message": {
                    "$ref": "#/components/messages/TerminalClientFrame"
                }
            }
        }
    },
