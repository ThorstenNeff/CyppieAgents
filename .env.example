# CyppieAgents — local-dev environment template (CYP-46)
#
# Copy this file to `.env` (which is gitignored) and fill in real values:
#     cp .env.example .env
# Or generate one automatically with random dev tokens:
#     ./scripts/dev-setup.sh
#
# NOTHING in this file is a real value — every right-hand side is a placeholder.
# NEVER commit a filled-in `.env`, and NEVER paste token values into chat/Discord.
#
# How the values are consumed (verified against the code, not invented):
#   * Server boot reads these via `Secrets.fromEnv` (boot/Secrets.kt) and `Application.kt`.
#     A missing required token fails CLOSED — the server refuses to boot rather than run
#     an unauthenticated hub.
#   * The desktop/JVM client reads HUB_HOST/HUB_PORT/HUB_TOKEN_*/OPERATOR_TOKEN via
#     `ShellConfig.jvm.kt` (app/shared) to point the UI at the server.
#
# The `.env` file is NOT auto-loaded by Gradle. Export it into the shell that runs the
# server / desktop app, e.g.:  `set -a; . ./.env; set +a`  (see docs/SETUP.md).

# ──────────────────────────────────────────────────────────────────────────────
# SERVER — required (fail-closed: boot aborts if any required token is missing)
# ──────────────────────────────────────────────────────────────────────────────

# One bearer token PER AGENT. The suffix is the agent id UPPERCASED, and must match
# the agent ids in your platform.config.json (default agents: po, frontend, backend).
# Generate each with:  openssl rand -hex 32
HUB_TOKEN_PO=<openssl rand -hex 32>
HUB_TOKEN_FRONTEND=<openssl rand -hex 32>
HUB_TOKEN_BACKEND=<openssl rand -hex 32>

# Privileged operator token — gates ACL changes and operator-only REST/WS (e.g. /api/events,
# /ws/events). The DESKTOP CLIENT reads the SAME variable name, so the value the client uses
# and the value the server expects are identical when both run from this same `.env`.
# Generate with:  openssl rand -hex 32
OPERATOR_TOKEN=<openssl rand -hex 32>

# ──────────────────────────────────────────────────────────────────────────────
# SERVER — optional (sensible defaults if unset)
# ──────────────────────────────────────────────────────────────────────────────

# Path to the platform config file. Default: platform.config.json (in the cwd).
# PLATFORM_CONFIG=platform.config.json

# Working root where the server clones the repo and creates one git worktree per agent
# (also holds the event-log SQLite db + hook spool). Default: .cyppie
# PLATFORM_GIT_ROOT=.cyppie

# Anthropic API key — OPTIONAL and only for a REAL agent run (launch: claude).
# By default agents authenticate with your OAuth subscription credentials (~/.claude);
# only set this if you explicitly intend key-based auth. Injected into each agent
# session's ENV (never a CLI arg), masked in logs, never echoed back.
# ANTHROPIC_API_KEY=<sk-ant-...>

# ──────────────────────────────────────────────────────────────────────────────
# DESKTOP / JVM CLIENT — optional (point the UI at the server)
# ──────────────────────────────────────────────────────────────────────────────

# Host/port the client connects to. The server binds 127.0.0.1:8787 (hardcoded).
# Defaults: HUB_HOST=localhost, HUB_PORT=8787 — leave unset for the standard local setup.
# HUB_HOST=localhost
# HUB_PORT=8787
